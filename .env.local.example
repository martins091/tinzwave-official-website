# Copy this file to .env.local and fill in real values, then restart `npm run dev`.
# In production (Vercel etc.), set the same keys under Project Settings -> Environment Variables.

# Contact form (app/contact/page.tsx) sends via EmailJS (https://www.emailjs.com).
# Without these, the contact form will fail with "Failed to send message."
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
